[Unit]
Description=OpenShift Update Proxy
After=network.target

[Service]
#User=username
Environment=HTTPS_PROXY=http://localhost:3128
WorkingDirectory=/opt/update-proxy
# pip install openshift-update-proxy into /opt/update-proxy/.venv first
ExecStart=/opt/update-proxy/.venv/bin/openshift-update-proxy
Restart=always

[Install]
WantedBy=multi-user.target
